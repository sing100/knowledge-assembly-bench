{
  "id": "thinking-fast-and-slow",
  "title": "思考，快与慢",
  "subtitle": "丹尼尔·卡尼曼",
  "intro": "组装卡尼曼的论证：直觉很强大，但会系统性地出错。",
  "kind": "book",
  "shape": "argument",
  "parts": [
    {
      "id": "root",
      "label": "《思考，快与慢》",
      "parent": null,
      "note": "直觉会系统性出错",
      "explain": "诺贝尔奖得主卡尼曼 2011 年的书。核心观点：人脑有两种思考方式，快的那种很能干，但会以可预测的方式犯错。"
    },
    {
      "id": "two",
      "label": "两个系统",
      "parent": "root",
      "note": "快直觉与慢推理",
      "explain": "卡尼曼用来描述大脑的比喻：一个快、一个慢的两种思考方式。全书都建立在这个框架上。"
    },
    {
      "id": "s1",
      "label": "系统1",
      "parent": "two",
      "note": "自动、快速、省力",
      "explain": "自动运行的直觉思维。看到「2+2」就冒出 4、看到生气的脸就感到不安，都是它在工作，不费力也停不下来。"
    },
    {
      "id": "s2",
      "label": "系统2",
      "parent": "two",
      "note": "费力、缓慢、懒惰",
      "explain": "需要专注的慢思考，比如算 17×24、填税表。它能纠正直觉，但很懒，常常直接接受系统1给的答案。"
    },
    {
      "id": "ease",
      "label": "认知放松",
      "parent": "two",
      "note": "熟悉就觉得真",
      "explain": "当信息看起来熟悉、清晰、好读时，大脑会觉得轻松，也更容易相信它是真的。重复多次的谎言就利用了这一点。"
    },
    {
      "id": "wysiati",
      "label": "眼见即为全部",
      "parent": "two",
      "note": "只用手头信息",
      "explain": "大脑只用眼前的信息编一个通顺的故事，不会去想「还缺了什么信息」。故事越连贯，人越自信，哪怕信息很少。"
    },
    {
      "id": "heur",
      "label": "启发式与偏差",
      "parent": "root",
      "note": "直觉走捷径",
      "explain": "大脑碰到难题时，会偷偷换成一个简单的问题来回答。这些捷径大多有用，但会带来可预测的错误。"
    },
    {
      "id": "anchor",
      "label": "锚定效应",
      "parent": "heur",
      "note": "被初始数字拉住",
      "explain": "先看到的一个数字会把后面的判断拉向它。比如先问「甘地去世时超过 114 岁吗」，人们估计的年龄会明显偏高。"
    },
    {
      "id": "avail",
      "label": "可得性启发",
      "parent": "heur",
      "note": "易想起当常见",
      "explain": "用「多容易想起例子」来判断一件事有多常见。飞机失事上新闻多，人们就高估坐飞机的危险。"
    },
    {
      "id": "repr",
      "label": "代表性启发",
      "parent": "heur",
      "note": "像不等于可能",
      "explain": "用「像不像」来判断可能性，忽略了基础比例。一个安静爱读书的人，人们会猜他是图书管理员，尽管农民多得多。"
    },
    {
      "id": "linda",
      "label": "琳达问题",
      "parent": "repr",
      "note": "合取谬误",
      "explain": "琳达热心社会运动。问人她更可能是「银行职员」还是「热心女权的银行职员」，多数人选后者，可后者的概率不可能更大。"
    },
    {
      "id": "smalln",
      "label": "小数定律",
      "parent": "heur",
      "note": "轻信小样本",
      "explain": "人们以为小样本也能反映整体。比如发现肾癌发病率最低的县多是小县，就去找原因，其实只是样本小、波动大。"
    },
    {
      "id": "regress",
      "label": "回归均值",
      "parent": "heur",
      "note": "极端之后趋常",
      "explain": "极端的表现之后，下一次通常更接近平均。表现好被表扬后变差、被批评后变好，常被误以为是表扬和批评的作用。"
    },
    {
      "id": "over",
      "label": "过度自信",
      "parent": "root",
      "note": "高估自己所知",
      "explain": "人们普遍高估自己知道多少、能预测多少。这一部分讲它的几种表现。"
    },
    {
      "id": "hindsight",
      "label": "后见之明",
      "parent": "over",
      "note": "事后都可预测",
      "explain": "事情发生后，人会觉得「我早就知道」。这让我们低估了世界的不确定性，也会不公平地评价决策者。"
    },
    {
      "id": "validity",
      "label": "有效性错觉",
      "parent": "over",
      "note": "信心不等于准",
      "explain": "即使有证据表明判断不准，人仍然对自己的判断很有信心。比如选股专家的业绩大多接近运气。"
    },
    {
      "id": "planning",
      "label": "规划谬误",
      "parent": "over",
      "note": "低估时间成本",
      "explain": "做计划时总是按最理想的情况估算，严重低估时间和成本。装修、写论文、修地铁都是这样。"
    },
    {
      "id": "choice",
      "label": "选择",
      "parent": "root",
      "note": "人不是理性人",
      "explain": "这一部分挑战经济学的假设：人在做选择时并不是冷静计算的「理性人」。"
    },
    {
      "id": "prospect",
      "label": "前景理论",
      "parent": "choice",
      "note": "相对参照点评估",
      "explain": "卡尼曼和特沃斯基提出的理论：人不是按最终财富，而是按相对某个参照点的「得」和「失」来做决定。"
    },
    {
      "id": "lossav",
      "label": "损失厌恶",
      "parent": "prospect",
      "note": "失去比得到痛",
      "explain": "失去 100 元的痛苦，大约比得到 100 元的快乐强一倍。所以人们会为了避免损失去冒险。"
    },
    {
      "id": "endow",
      "label": "禀赋效应",
      "parent": "prospect",
      "note": "拥有就更值钱",
      "explain": "东西一旦归自己所有，就觉得它更值钱。实验里拿到马克杯的人，卖价通常是买价的两倍左右。"
    },
    {
      "id": "framing",
      "label": "框架效应",
      "parent": "choice",
      "note": "说法改变选择",
      "explain": "同一件事换个说法，选择就变了。「手术存活率 90%」和「死亡率 10%」是一回事，但前者让更多人同意手术。"
    },
    {
      "id": "selves",
      "label": "两个自我",
      "parent": "root",
      "note": "体验与记忆",
      "explain": "全书最后一部分：人身上有两个「我」，一个在经历，一个在记住，它们对幸福的判断并不一致。"
    },
    {
      "id": "exper",
      "label": "体验自我",
      "parent": "selves",
      "note": "活在当下",
      "explain": "此时此刻正在感受的那个你，回答的是「现在感觉怎么样」。"
    },
    {
      "id": "remem",
      "label": "记忆自我",
      "parent": "selves",
      "note": "讲故事做决定",
      "explain": "事后回顾、讲故事的那个你，回答的是「整体来说怎么样」。下一次做选择的，是它。"
    },
    {
      "id": "peakend",
      "label": "峰终定律",
      "parent": "selves",
      "note": "只记峰值和结尾",
      "explain": "人回忆一段经历时，主要记住最强烈的时刻和结尾，几乎不管持续了多久。"
    },
    {
      "id": "colon",
      "label": "结肠镜实验",
      "parent": "peakend",
      "note": "长但结尾好更好受",
      "explain": "同样做结肠镜检查，在结尾多加几分钟较轻的不适，病人反而记得整体没那么痛苦。"
    },
    {
      "id": "people",
      "label": "人物",
      "parent": "root",
      "note": "提出者",
      "explain": "卡尼曼和特沃斯基，两位心理学家，几十年合作提出这些理论，是全书论证的提出者。"
    },
    {
      "id": "kahneman",
      "label": "丹尼尔·卡尼曼",
      "parent": "people",
      "note": "2002年诺奖",
      "explain": "以色列裔美国心理学家，因把心理学引入经济学获 2002 年诺贝尔经济学奖。"
    },
    {
      "id": "tversky",
      "label": "阿莫斯·特沃斯基",
      "parent": "people",
      "note": "长期合作者",
      "explain": "卡尼曼几十年的合作伙伴，许多核心实验是两人一起做的。1996 年去世，未能分享诺奖。"
    }
  ],
